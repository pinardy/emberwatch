#!/bin/sh
# Pre-commit check: typecheck, lint the staged files, and the fast test suite
# (everything but the full balance harness, which `npm run test:balance` runs).
# Installed by `npm install` (the `prepare` script sets core.hooksPath).
# Skip once with `git commit --no-verify`.
set -e

echo "pre-commit: typecheck"
npm run --silent typecheck

# Staged files that still exist (added, copied, modified, renamed), by extension.
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.mjs' '*.cjs')
if [ -n "$staged" ]; then
  echo "pre-commit: lint staged files"
  git diff --cached --name-only --diff-filter=ACMR -z -- '*.ts' '*.tsx' '*.js' '*.mjs' '*.cjs' |
    xargs -0 npx --no-install eslint --no-warn-ignored
fi

echo "pre-commit: fast tests"
npm test --silent
